# caches and generated data (see scripts/prepare_*.py)
cache/*
!cache/lookaway/
cache/lookaway/checkpoints/
cache/lookaway/rollouts/*
!cache/lookaway/rollouts/lookaway-sample-level-60steps/
data/
dumps/
results.json
results.failed.json
*.stale
.teacher_neg.*/
.teacher_neg.backup.*/
token_priors.json
token_freq.json
token_scores_full.jsonl

# training artifacts
checkpoints/
rollouts/
logs/
tensorboard_log/
wandb/
outputs/
*.safetensors
*.parquet

# eval artifacts (benchmark images / jsons are downloaded by eval/prepare_data.py)
eval/*_images/
eval/*_data/
eval/*.json
eval/model_answer/
eval/judge/

# python
__pycache__/
*.pyc
*.egg-info/
.eggs/
build/
dist/
.venv/

# editors / os
.idea/
.vscode/
.DS_Store
deliverables/
*.bak*
exp/

# tracked frozen training artifacts (override the blanket rules above)
!cache/lookaway/trainset_clean.parquet
!cache/lookaway/rollouts/lookaway-sample-level-60steps/
!cache/lookaway/rollouts/lookaway-sample-level-60steps/**
!cache/lookaway/rollouts/
cache/lookaway/images/
cache/lookaway/teacher_images/
cache/lookaway/teacher_neg/
